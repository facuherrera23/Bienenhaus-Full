# ============================================================
# Bienenhaus - Variables de Entorno para PRODUCCIÓN
# ============================================================
# Copiar este archivo a .env.production y completar TODOS los valores
# NUNCA commitear este archivo con valores reales
# ============================================================

# ------------------------------------------------------------
# Supabase (PRODUCCIÓN)
# ------------------------------------------------------------
# Obtener en: Supabase Dashboard → Settings → API
VITE_SUPABASE_URL=https://<TU_PROJECT_REF>.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9... (anon public key)

# Para Supabase CLI (deploy)
SUPABASE_PROD_REF=<TU_PROJECT_REF>
SUPABASE_ACCESS_TOKEN=sbp_xxxxxxxxxxxxxxxxxxxxxxxx (Personal Access Token)

# ------------------------------------------------------------
# Mercado Libre (PRODUCCIÓN)
# ------------------------------------------------------------
# Obtener en: https://developers.mercadolibre.com.ar/ → Mis aplicaciones
ML_CLIENT_ID=1234567890123456
ML_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Generar con: openssl rand -hex 32
ML_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Para sync interno (cron/jobs)
ML_SYNC_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Cifrado AES-256-GCM para tokens ML (generar: openssl rand -hex 32)
CRYPTO_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------
# Supabase Auth / Admin
# ------------------------------------------------------------
# Obtener en: Supabase Dashboard → Settings → API → service_role (secret)
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9... (service_role key)

# URL base del admin (para redirects OAuth)
ADMIN_BASE_URL=https://bienenhaus.com.ar/admin

# ------------------------------------------------------------
# Vercel (Deploy Frontend)
# ------------------------------------------------------------
VERCEL_PROD_PROJECT=bienenhaus-admin
VERCEL_ORG_ID=team_xxxxxxxx
VERCEL_PROJECT_ID=prj_xxxxxxxx

# ------------------------------------------------------------
# Sentry (Opcional - Monitoreo errores)
# ------------------------------------------------------------
VITE_SENTRY_DSN=https://xxxxx@sentry.io/xxxxx
VITE_APP_VERSION=1.0.0

# ------------------------------------------------------------
# Configuración App
# ------------------------------------------------------------
# Base path para GitHub Pages (si aplica)
VITE_BASE_PATH=/admin/

# ============================================================
# NOTAS IMPORTANTES
# ============================================================
# 1. ML_WEBHOOK_SECRET: Debe coincidir EXACTAMENTE con el auth_token
#    que registres en los webhooks de Mercado Libre
# 2. CRYPTO_SECRET: Debe ser EXACTAMENTE 32 bytes (64 chars hex)
#    Si cambias esto, todos los tokens ML cifrados se pierden
# 3. ADMIN_BASE_URL: Debe terminar en /admin (sin slash final extra)
# 4. SERVICE_ROLE_KEY: NUNCA exponer en frontend, solo en Supabase CLI/secrets
# 5. VITE_SUPABASE_ANON_KEY: Es pública, va en el bundle del frontend
# 6. Generar secrets seguros:
#    openssl rand -hex 32  # para ML_WEBHOOK_SECRET, CRYPTO_SECRET, ML_SYNC_SECRET
# ============================================================