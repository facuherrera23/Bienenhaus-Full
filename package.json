{
  "name": "bienenhaus",
  "private": true,
  "version": "0.0.0",
  "description": "BIENENHAUS PROPIEDADES — Landing pública + Panel Administrativo",
  "scripts": {
    "dev": "pnpm --filter @bienenhaus/landing dev",
    "dev:admin": "pnpm --filter @bienenhaus/admin dev",
    "build": "pnpm -r build",
    "demo": "node scripts/serve.mjs",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @bienenhaus/admin test:e2e"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.111.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/preact": "^3.2.4",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^30.0.1",
    "msw": "^2.15.0",
    "playwright": "^1.62.1",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@sentry/browser": "^10.69.0"
  }
}
