{
  "name": "bienenhaus",
  "private": true,
  "version": "0.0.0",
  "description": "BIENENHAUS PROPIEDADES — Landing pública + Panel Administrativo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm --filter @bienenhaus/landing dev",
    "dev:admin": "pnpm --filter @bienenhaus/admin dev",
    "build": "pnpm -r build",
    "demo": "node scripts/serve.mjs",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "test": "pnpm --filter @bienenhaus/admin test",
    "test:e2e": "pnpm --filter @bienenhaus/admin test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.62.1",
    "@supabase/supabase-js": "^2.111.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/preact": "^3.2.4",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-plugin-preact": "^0.1.0",
    "jsdom": "^30.0.1",
    "msw": "^2.15.0",
    "pixelmatch": "7.2.0",
    "playwright": "^1.62.1",
    "pngjs": "7.0.0",
    "prettier": "^3.6.2",
    "sharp": "^0.35.3",
    "tsx": "^4.23.5",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.7.1",
    "@sentry/browser": "^10.69.0",
    "react-hook-form": "^7.84.0",
    "zod": "^3.25.76"
  }
}
