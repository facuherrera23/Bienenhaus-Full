# SMTP para Supabase Cloud (proyecto rnldqiwwzhjnurkguihu).
# Copiá a .env.smtp (gitignored) y corré: node scripts/configure-smtp.mjs
# El access token se genera en https://supabase.com/dashboard/account/tokens (sbp_...)
SUPABASE_ACCESS_TOKEN=sbp_xxxxxxxx
SUPABASE_PROJECT_REF=rnldqiwwzhjnurkguihu

# --- Resend (SMTP) ---
# API key: resend.com → API Keys → Create API Key (re_xxxx).
# Verificar el dominio en resend.com → Domains (agrega DKIM/SPF vía DNS).
# SMTP: host smtp.resend.com, puerto 465 (SSL) o 587 (TLS), user "resend".
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=re_xxxxxxxx
SMTP_SENDER_NAME=BIENENHAUS
SMTP_SENDER_EMAIL=no-reply@bienenhaus.com.ar

# --- Auth links (opcional pero recomendado) ---
SITE_URL=https://bienenhaus.com.ar/admin
REDIRECT_URLS=https://bienenhaus.com.ar/admin/**
