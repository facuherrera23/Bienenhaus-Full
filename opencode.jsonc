{
    "$schema": "https://opencode.ai/config.json",
    "plugin": ["oh-my-openagent@latest"],

    // ============================================================
    // SKILLS — Bienenhaus Design System Stack
    // 6 layered design skills (project-scoped under .opencode/skills/):
    //   bienenhaus-design-system     PRIORITY OVERRIDE (tokens/colors/components)
    //   frontend-design              Visual principles (Awwwards-level)
    //   frontend-design-systems      Atomic design + token architecture
    //   designing-frontend-interfaces BEFORE/IMPLEMENT/ITERATE methodology
    //   building-accessible-interfaces WCAG AA+ practical rules
    //   reviewing-interface-quality   7-dimension visual audit gate
    // The `frontend` agent auto-loads all 6 (see .opencode/agents/frontend.md).
    // ============================================================
    "skill": {
        "bienenhaus-design-system": {
            "description": "Authoritative Bienenhaus design system — tokens, colors, components, layout, branding. PRIORITY OVERRIDE over all generic design skills."
        },
        "frontend-design": {
            "description": "Visual design principles (hierarchy, rhythm, typography, color, motion, fidelity) for senior frontend designers."
        },
        "frontend-design-systems": {
            "description": "Atomic design methodology, token architecture, component API design, and design system evolution."
        },
        "designing-frontend-interfaces": {
            "description": "BEFORE/IMPLEMENT/ITERATE process for designing new interfaces and redesigns."
        },
        "building-accessible-interfaces": {
            "description": "WCAG AA+ practical accessibility: contrast, focus, keyboard, ARIA, reduced motion, screen reader."
        },
        "reviewing-interface-quality": {
            "description": "7-dimension visual audit gate — design system compliance, responsive, states, a11y, motion, hierarchy, fidelity."
        },
    },

    // ============================================================
    // AGENTS — Built-in agents + Bienenhaus specialized agents
    // Bienenhaus agents are defined as markdown files in
    // .opencode/agents/ (architect, qa, debugger, database,
    // frontend, backend) and override the bare model config here.
    // Built-in agents keep their oh-my-openagent prompts.
    // The `frontend` agent auto-loads all 6 design skills above.
    // ============================================================
    "agent": {
        "build": { "model": "nvidia/glm-5.2" },
        "plan": { "model": "nvidia/glm-5.2" },
        "sisyphus": { "model": "nvidia/glm-5.2" },
        "sisyphus-junior": { "model": "nvidia/glm-5.2" },
        "explore": { "model": "nvidia/glm-5.2" },
        "librarian": { "model": "nvidia/glm-5.2" },
        "oracle": { "model": "nvidia/glm-5.2" },
        "metis": { "model": "nvidia/glm-5.2" },
        "momus": { "model": "nvidia/glm-5.2" },
        "multimodal-looker": { "model": "nvidia/glm-5.2" },
        "atlas": { "model": "nvidia/glm-5.2" },
        "prometheus": { "model": "nvidia/glm-5.2" },
        "hephaestus": { "model": "nvidia/glm-5.2" },
        "OpenCode-Builder": { "model": "nvidia/glm-5.2" },
    },

    // ============================================================
    // MCP SERVERS
    // Organized by category:
    //
    // CORE (always-on, low context cost):
    //   - github         GitHub MCP (existing)
    //   - context7       Up-to-date library docs (NEW)
    //   - supabase       Supabase schema/data/RLS (existing, OAuth)
    //   - playwright     Browser inspection & E2E (existing)
    //
    // INFRASTRUCTURE (local dev):
    //   - filesystem     File operations (existing)
    //   - docker         Docker containers for local Supabase (existing)
    //
    // PRODUCTION (opt-in, requires OAuth):
    //   - sentry         Production errors & regressions (NEW)
    //
    // RESEARCH (low cost, on-demand):
    //   - gh_grep        Code examples search across GitHub (NEW)
    //
    // NOTES:
    //   - Web search (websearch) + web fetch (webfetch) are
    //     OpenCode BUILT-IN tools. No MCP needed.
    //   - Tool search/triage: no stable solution exists in v1.18.
    //     Scout subagent (built-in) covers external research.
    //     Risk of breaking the env outweighs benefit — NOT installed.
    // ============================================================
    "mcp": {
        // ---- CORE ----
        "github": {
            "type": "local",
            "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
            "environment": {
                "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_PERSONAL_ACCESS_TOKEN}",
            },
            "enabled": true,
            "timeout": 30000,
        },
        "context7": {
            "type": "remote",
            "url": "https://mcp.context7.com/mcp",
            "enabled": true,
            "timeout": 30000,
        },
        "supabase": {
            "type": "remote",
            "url": "https://mcp.supabase.com/mcp?project_ref=rnldqiwwzhjnurkguihu",
            "enabled": true,
            "oauth": {},
            "timeout": 30000,
        },
        "playwright": {
            "type": "local",
            "command": ["npx", "-y", "@playwright/mcp@latest"],
            "enabled": true,
            "timeout": 60000,
        },

        // ---- INFRASTRUCTURE ----
        "filesystem": {
            "type": "local",
            "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem", "."],
            "environment": {
                "NODE_ENV": "production",
            },
            "enabled": true,
            "timeout": 15000,
        },
        "docker": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "@thelord/mcp-server-docker-npx@latest",
                "--docker-host",
                "npipe:////./pipe/docker_engine",
            ],
            "enabled": true,
            "timeout": 30000,
        },

        // ---- PRODUCTION ----
        // Sentry MCP requires one-time OAuth: `opencode mcp auth sentry`
        // Reads errors, stack traces, and regressions from Sentry.io.
        // Bienenhaus uses @sentry/browser in the admin panel.
        "sentry": {
            "type": "remote",
            "url": "https://mcp.sentry.dev/mcp",
            "oauth": {},
            "enabled": true,
            "timeout": 30000,
        },

        // ---- RESEARCH ----
        // NOTE: `grep_app` (https://mcp.grep.app) is ALREADY registered by the
        // oh-my-openagent plugin (see `opencode mcp list` above — "grep_app").
        // It serves grep.app code-pattern search. To avoid a duplicate server
        // pointing at the same endpoint, gh_grep is DISABLED here — use the
        // built-in `grep_app` server instead.
        "gh_grep": {
            "type": "remote",
            "url": "https://mcp.grep.app",
            "enabled": false,
            "timeout": 15000,
        },
    },
}
