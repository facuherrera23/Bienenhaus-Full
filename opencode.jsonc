{
    "$schema": "https://opencode.ai/config.json",
    "plugin": ["oh-my-openagent@latest"],
    "agent": {
        "build": { "model": "opencode/big-pickle" },
        "plan": { "model": "opencode/big-pickle" },
        "sisyphus": { "model": "opencode/big-pickle" },
        "sisyphus-junior": { "model": "opencode/big-pickle" },
        "explore": { "model": "opencode/big-pickle" },
        "librarian": { "model": "opencode/big-pickle" },
        "oracle": { "model": "opencode/big-pickle" },
        "metis": { "model": "opencode/big-pickle" },
        "momus": { "model": "opencode/big-pickle" },
        "multimodal-looker": { "model": "opencode/big-pickle" },
        "atlas": { "model": "opencode/big-pickle" },
        "prometheus": { "model": "opencode/big-pickle" },
        "hephaestus": { "model": "opencode/big-pickle" },
        "OpenCode-Builder": { "model": "opencode/big-pickle" }
    },
    "mcp": {
        "github": {
            "type": "local",
            "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
            "environment": {
                "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_PERSONAL_ACCESS_TOKEN}",
            },
            "enabled": true,
            "timeout": 30000,
        },
        "playwright": {
            "type": "local",
            "command": ["npx", "-y", "@playwright/mcp@latest"],
            "enabled": true,
            "timeout": 60000,
        },
        "supabase": {
            "type": "remote",
            "url": "https://mcp.supabase.com/mcp?project_ref=rnldqiwwzhjnurkguihu",
            "enabled": true,
            "oauth": {},
            "timeout": 30000,
        },
        "filesystem": {
            "type": "local",
            "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem", "."],
            "environment": {
                "NODE_ENV": "production",
            },
            "enabled": true,
            "timeout": 15000,
        },
        "docker": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "@thelord/mcp-server-docker-npx@latest",
                "--docker-host",
                "npipe:////./pipe/docker_engine",
            ],
            "enabled": true,
            "timeout": 30000,
        },
    },
}
