# Copiá a .env y completá con los datos de tu proyecto Supabase.
# Local (Docker): supabase start  →  muestra estas URLs en consola.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=tu_anon_key

# Base path para deployment (ej: '/admin/' para GitHub Pages, '/' para subdominio)
VITE_BASE_PATH=/admin/

# Sentry (monitoreo de errores). Opcional: sin DSN la inicialización se omite
# silenciosamente (no se reporta nada). DSN del proyecto en sentry.io.
VITE_SENTRY_DSN=https://xxx@sentry.io/yyy
# Versión reportada como "release" en Sentry. Default: 'dev'. En CI se setea
# automáticamente al SHA del commit (ver .github/workflows/deploy-pages.yml).
VITE_APP_VERSION=dev
