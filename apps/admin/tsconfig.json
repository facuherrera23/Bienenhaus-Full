{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "jsx": "react-jsx",
        "jsxImportSource": "preact",
        "types": ["vite/client", "vitest/globals", "@testing-library/jest-dom"],
        "noEmit": true,
        "baseUrl": ".",
        "paths": {
            "@/*": ["src/*"],
            "@lib/*": ["src/lib/*"],
            "@components/*": ["src/components/*"],
            "@pages/*": ["src/pages/*"],
            "@store/*": ["src/store/*"],
            "@bienenhaus/supabase": ["../../packages/bienenhaus-supabase/src"]
        }
    },
    "include": ["src", "vite.config.ts"],
    "exclude": ["src/**/*.test.tsx", "src/**/__tests__/**", "src/test/**"]
}
