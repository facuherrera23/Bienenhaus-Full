{
  "$schema": "https://raw.githubusercontent.com/GoogleChrome/lighthouse/main/docs/authors.json",
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "chromeFlags": "--no-sandbox --disable-gpu --disable-dev-shm-usage",
        "throttling": {
          "rttMs": 40,
          "throughputKbps": 10240,
          "cpuSlowdownMultiplier": 1,
          "requestLatencyMs": 0,
          "downloadThroughputKbps": 0,
          "uploadThroughputKbps": 0
        },
        "skipAudits": ["uses-text-compression", "uses-long-cache-ttl"]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.98 }],
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:best-practices": ["error", { "minScore": 1 }],
        "categories:seo": ["error", { "minScore": 1 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
        "total-blocking-time": ["error", { "maxNumericValue": 200 }],
        "first-contentful-paint": ["warn", { "maxNumericValue": 1800 }],
        "interactive": ["warn", { "maxNumericValue": 3500 }],
        "resource-summary:script:size": ["error", { "maxNumericValue": 153600 }],
        "resource-summary:stylesheet:size": ["error", { "maxNumericValue": 51200 }],
        "resource-summary:total:size": ["warn", { "maxNumericValue": 1048576 }],
        "unused-javascript": ["warn", { "maxNumericValue": 51200 }],
        "render-blocking-resources": ["warn", { "maxNumericValue": 200 }],
        "unminified-javascript": ["error", {}],
        "unminified-css": ["error", {}],
        "uses-optimized-images": ["warn", {}],
        "uses-responsive-images": ["warn", {}],
        "uses-rel-preconnect": ["warn", {}],
        "uses-rel-preload": ["warn", {}],
        "efficient-animated-content": ["warn", {}],
        "legacy-javascript": ["warn", {}],
        "dom-size": ["warn", { "maxNumericValue": 1500 }],
        "mainthread-work-breakdown": ["warn", { "maxNumericValue": 3500 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage",
      "reportFilename": "lighthouse-report-desktop.json"
    },
    "output": {
      "reports": ["json", "html"]
    }
  }
}