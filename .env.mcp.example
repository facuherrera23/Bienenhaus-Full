# OpenCode MCP Environment Variables
# Copy this to .env in your project root or set these in your shell/profile
# NEVER commit actual tokens to git!

# ==========================================
# REQUIRED TOKENS (must be set for MCPs to work)
# ==========================================

# GitHub Personal Access Token (classic)
# Create at: https://github.com/settings/tokens
# Required scopes: repo, read:org, read:user, workflow
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_your_github_token_here

# ==========================================
# OPTIONAL TOKENS (for enhanced functionality)
# ==========================================

# Supabase Access Token (for CLI auth, optional - MCP uses OAuth)
# Create at: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=sbp_your_supabase_token_here

# Context7 API Key (if you have a paid plan for higher rate limits)
# CONTEXT7_API_KEY=your_context7_key_here

# ==========================================
# PROJECT-SPECIFIC (auto-configured)
# ==========================================

# Supabase Project Reference (already configured in MCP)
# SUPABASE_PROJECT_REF=rnldqiwwzhjnurkguihu

# Project root path (already configured in filesystem MCP)
# PROJECT_ROOT=C:/Users/facuh/OneDrive/Escritorio/Mis Proyectos/Landing Page/landing