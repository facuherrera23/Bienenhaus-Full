# Variables de entorno para las Edge Functions (supabase functions deploy).
# Copiá este archivo a supabase/functions/.env y completá los valores.

# Secret usado para derivar la clave AES-256-GCM que cifra los tokens de ML.
CRYPTO_SECRET=

# Credenciales de la aplicación de Mercado Libre (MercadoLibre Developers).
ML_CLIENT_ID=
ML_CLIENT_SECRET=

# Opcional: secret compartido para invocar ml-sync desde cron/scripts.
ML_SYNC_SECRET=

# Opcional: base URL del admin para el redirect post-conexión (si no viene en state).
# ADMIN_BASE_URL=http://localhost:5173/admin
